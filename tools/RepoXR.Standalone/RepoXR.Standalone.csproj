<Project Sdk="Microsoft.NET.Sdk">

    <!-- Starts RepoXR without BepInEx's preloader/chainloader, for builds where its patches are baked in -->
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>disable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>RepoXR.Standalone</RootNamespace>
        <GameManaged Condition="'$(GameManaged)' == ''">$(MSBuildThisFileDirectory)../../work/game/REPO_Data/Managed</GameManaged>
        <RepoXRRuntimeDeps Condition="'$(RepoXRRuntimeDeps)' == ''">$(MSBuildThisFileDirectory)../../work/downloads/RepoXR-1.2.3/BepInEx/plugins/RepoXR/RuntimeDeps</RepoXRRuntimeDeps>
        <BepInExCore Condition="'$(BepInExCore)' == ''">$(MSBuildThisFileDirectory)../../work/downloads/BepInEx5/BepInEx/core</BepInExCore>
        <RepoXRDll Condition="'$(RepoXRDll)' == ''">$(MSBuildThisFileDirectory)../../work/repoxr-src/bin/Release/netstandard2.1/RepoXR.dll</RepoXRDll>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../Shared/PhotonAccess.cs" Link="Cloud/PhotonAccess.cs" />
        <Compile Include="../Shared/CloudRoomRouting.cs" Link="Cloud/CloudRoomRouting.cs" />
        <Compile Include="../Shared/CloudAppIds.cs" Link="Cloud/CloudAppIds.cs" />
        <Compile Include="../Shared/CloudInput.cs" Link="Cloud/CloudInput.cs" />
        <Compile Include="../Shared/CloudWebsite.cs" Link="Cloud/CloudWebsite.cs" />
        <Compile Include="../Shared/CloudSettings.cs" Link="Cloud/CloudSettings.cs" />
        <Compile Include="../Shared/CloudProfile.cs" Link="Cloud/CloudProfile.cs" />
        <Compile Include="../Shared/CloudConfigFile.cs" Link="Cloud/CloudConfigFile.cs" />
        <Compile Include="../Shared/DialogLabels.cs" Link="UI/DialogLabels.cs" />
        <Compile Include="../Shared/ModalMetrics.cs" Link="UI/ModalMetrics.cs" />
        <Reference Include="UnityEngine.IMGUIModule" HintPath="$(GameManaged)/UnityEngine.IMGUIModule.dll" Private="false" />
        <Reference Include="Unity.Localization" HintPath="$(GameManaged)/Unity.Localization.dll" Private="false" />
        <Reference Include="Unity.ResourceManager" HintPath="$(GameManaged)/Unity.ResourceManager.dll" Private="false" />
        <Reference Include="UnityEngine.JSONSerializeModule">
            <HintPath>$(GameManaged)/UnityEngine.JSONSerializeModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- Overrides name RepoXR's internal types; compile against a publicized copy of the mod -->
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
        <Reference Include="RepoXR" Publicize="true">
            <!-- RepoXR with patches/repoxr applied (scripts/prepare-repoxr.sh) -->
            <HintPath>$(RepoXRDll)</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- RepoXR's XR dependencies as shipped in its release (RuntimeDeps); internals are needed for OpenXR features -->
        <Reference Include="Unity.XR.OpenXR" Publicize="true">
            <HintPath>$(RepoXRRuntimeDeps)/Unity.XR.OpenXR.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.XR.Management">
            <HintPath>$(RepoXRRuntimeDeps)/Unity.XR.Management.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- The game itself, for overrides of game methods and the Steam menus (renamed to REPO.Game when staged for
             Quest); publicized for the menu internals those use -->
        <Reference Include="Assembly-CSharp" Publicize="true">
            <HintPath>$(GameManaged)/Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- Easy Save 3, which the game's saves use (CosmeticsCloud reads MetaSave.es3 as MetaManager does) -->
        <Reference Include="Assembly-CSharp-firstpass">
            <HintPath>$(GameManaged)/Assembly-CSharp-firstpass.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="PhotonVoice">
            <HintPath>$(GameManaged)/PhotonVoice.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- NetworkManager's cloud disconnect patch targets its PUN callback. -->
        <Reference Include="PhotonUnityNetworking">
            <HintPath>$(GameManaged)/PhotonUnityNetworking.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="PhotonRealtime">
            <HintPath>$(GameManaged)/PhotonRealtime.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(GameManaged)/UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- The game's menus: uGUI buttons and TextMeshPro texts -->
        <Reference Include="UnityEngine.UI">
            <HintPath>$(GameManaged)/UnityEngine.UI.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.UIModule">
            <HintPath>$(GameManaged)/UnityEngine.UIModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.TextRenderingModule">
            <HintPath>$(GameManaged)/UnityEngine.TextRenderingModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.TextMeshPro">
            <HintPath>$(GameManaged)/Unity.TextMeshPro.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="BepInEx">
            <HintPath>$(BepInExCore)/BepInEx.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- The Steam shim (Facepunch.Steamworks.Win64 on Quest) and SteamKit2, for SteamSetup (Android only) -->
        <Reference Include="Facepunch.Steamworks.Win64">
            <HintPath>$(MSBuildThisFileDirectory)../SteamShim/bin/Release/netstandard2.1/Facepunch.Steamworks.Win64.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="SteamKit2">
            <HintPath>$(MSBuildThisFileDirectory)../SteamShim/bin/Release/netstandard2.1/SteamKit2.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- The HarmonyX that ships with BepInEx 5 (and in the APK); target of an Android override -->
        <Reference Include="0Harmony">
            <HintPath>$(BepInExCore)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <Target Name="ValidateStandaloneInputs" BeforeTargets="PrepareForBuild">
        <Error Condition="!Exists('$(GameManaged)/Assembly-CSharp.dll')"
               Text="R.E.P.O. assemblies missing: $(GameManaged). Set GameManaged to your game's REPO_Data/Managed directory." />
        <Error Condition="!Exists('$(RepoXRDll)')"
               Text="Patched RepoXR.dll missing. Prepare RepoXR from the pinned sources and patches before building standalone." />
        <Error Condition="!Exists('$(MSBuildThisFileDirectory)../SteamShim/bin/Release/netstandard2.1/Facepunch.Steamworks.Win64.dll')"
               Text="Build tools/SteamShim in Release before building standalone; the cloud adapter requires the matching shim." />
    </Target>
</Project>
