<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Minimal stand-in for Unity's UnityEngine.CoreModule so that the game's own Photon3Unity3D.dll and
        PhotonRealtime.dll can run in a plain .NET process. Only the members those two assemblies reference exist.
    -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <AssemblyName>UnityEngine.CoreModule</AssemblyName>
        <RootNamespace>UnityEngine</RootNamespace>
        <AssemblyVersion>0.0.0.0</AssemblyVersion>
        <FileVersion>0.0.0.0</FileVersion>
        <Nullable>disable</Nullable>
    </PropertyGroup>

</Project>
