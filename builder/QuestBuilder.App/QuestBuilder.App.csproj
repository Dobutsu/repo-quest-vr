<Project Sdk="Microsoft.NET.Sdk">

    <!-- The builder's window (Avalonia), what players run: a thin layer over QuestBuilder.Core -->
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <RootNamespace>RepoQuest.Builder.App</RootNamespace>
        <AssemblyName>RepoQuestBuilder</AssemblyName>
        <ApplicationIcon>Assets/app.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <!-- Release builds for players (scripts/release.sh: dotnet publish -r win-x64): one exe that needs nothing
         installed. Only with a runtime identifier, so that dotnet build / dotnet run keep working on the Mac -->
    <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <!-- Avalonia's native libraries (Skia, HarfBuzz) are unpacked on start. The .NET tools do not run in this
             process: MonoMod cannot hook the JIT of a single-file app, so they come as a normal folder (tools.zip) -->
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <!-- Cecil, Harmony and the bindings work by reflection: trimming would break them -->
        <PublishTrimmed>false</PublishTrimmed>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../QuestBuilder.Core/QuestBuilder.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets/app.ico;Assets/logo.png" />
        <!-- The kit for release builds (scripts/make-kit.sh -> kit.zip): Kit.ExtractEmbedded reads this resource -->
        <EmbeddedResource Include="$(KitZip)" LogicalName="kit.zip" Condition="'$(KitZip)' != ''" />
        <!-- The .NET tools as a self-contained folder (QuestBuilder.Cli published without bundling; ToolLauncher.For) -->
        <EmbeddedResource Include="$(ToolsZip)" LogicalName="tools.zip" Condition="'$(ToolsZip)' != ''" />
        <!-- The public half of the release key: updates must be signed with the private half (ReleaseSigning) -->
        <EmbeddedResource Include="../release-public-key.txt" LogicalName="release-public-key.txt"
                          Condition="Exists('../release-public-key.txt')" />
        <!-- Where updates come from when neither the update-source option nor update-source.txt says (UpdateSource.Resolve) -->
        <AssemblyMetadata Include="RepoQuestUpdateSource" Value="$(UpdateSource)" Condition="'$(UpdateSource)' != ''" />
    </ItemGroup>

</Project>
