<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RepoQuest.Builder.App.App"
             RequestedThemeVariant="Default">
    <!-- Fluent, following the system's light or dark theme -->
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
