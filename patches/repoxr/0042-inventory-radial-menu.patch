+    // Quest port: the stick click of the Crouch binding (R3). A tap crouches (as a toggle), a hold opens the
+    // inventory menu (VRInventoryRadial), like the chat button: a tap chats, a hold opens the expressions
+
+    private const float InventoryHoldTime = 0.25f;
+
+    // While the stick click is down the stick picks a slot: it must not turn, push, pull, rotate or scroll
+    private static readonly string[] StickActions = ["Turn", "Push", "Pull", "Rotation", "Scroll"];
+
+    private int stickClickFrame = -1;
+    private float stickClickPressedAt = -1;
+    private bool stickClickHeld;
+    private bool stickClickTap;
+    private bool stickClickReleased;
+    private bool stickActionsDisabled;
+    private float stickRestoreUntil = -1;
+
+    /// <summary>
+    /// The stick click was tapped this frame: crouch
+    /// </summary>
+    public bool CrouchTapped()
+    {
+        PollStickClick();
+        return stickClickTap;
+    }
+
+    /// <summary>
+    /// The stick click is held past the hold time: the inventory menu is wanted
+    /// </summary>
+    public bool InventoryHeld()
+    {
+        PollStickClick();
+        return stickClickHeld;
+    }
+
+    /// <summary>
+    /// The stick click was let go this frame after a hold: the inventory menu picks its slot
+    /// </summary>
+    public bool InventoryReleased()
+    {
+        PollStickClick();
+        return stickClickReleased;
+    }
+
+    /// <summary>
+    /// Reads the stick click once a frame, from whoever asks first (the game's crouch check can run before or after
+    /// this component's Update)
+    /// </summary>
+    private void PollStickClick()
+    {
+        if (stickClickFrame == Time.frameCount)
+            return;
+
+        stickClickFrame = Time.frameCount;
+        stickClickTap = false;
+        stickClickReleased = false;
+
+        var crouch = playerInput.actions.FindAction("Crouch");
+        if (crouch == null)
+            return;
+
+        // After the menu the stick actions come back once the stick is centered (or a second later): a stick still
+        // tilted towards a slot would snap turn or push the item away otherwise
+        if (stickRestoreUntil >= 0 && (VRInventoryRadial.StickCentered || Time.unscaledTime > stickRestoreUntil))
+        {
+            stickRestoreUntil = -1;
+            SetStickActionsDisabled(false);
+        }
+
+        if (crouch.WasPressedThisFrame())
+        {
+            stickClickPressedAt = Time.unscaledTime;
+            stickClickHeld = false;
+            stickRestoreUntil = -1;
+            SetStickActionsDisabled(VRInventoryRadial.CanOpen());
+        }
+
+        if (stickClickPressedAt < 0)
+            return;
+
+        if (crouch.IsPressed())
+        {
+            if (!stickClickHeld && Time.unscaledTime - stickClickPressedAt >= InventoryHoldTime)
+                stickClickHeld = true;
+
+            return;
+        }
+
+        // Let go: a hold that opened the menu picks a slot, anything else is a tap (a long press with no menu still
+        // crouches)
+        if (stickClickHeld && VRInventoryRadial.IsOpen)
+            stickClickReleased = true;
+        else
+            stickClickTap = true;
+
+        stickClickHeld = false;
+        stickClickPressedAt = -1;
+
+        if (stickActionsDisabled)
+            stickRestoreUntil = Time.unscaledTime + 1;
+    }
+
+    private void SetStickActionsDisabled(bool disabled)
+    {
+        if (stickActionsDisabled == disabled)
+            return;
+
+        stickActionsDisabled = disabled;
+
+        foreach (var name in StickActions)
+        {
+            var action = playerInput.actions.FindAction(name);
+            if (action == null)
+                continue;
+
+            if (disabled)
+                action.Disable();
+            else if (playerInput.inputIsActive)
+                action.Enable();
+        }
+    }
