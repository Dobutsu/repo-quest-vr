+    /// <summary>
+    /// Single-pass: before the headset camera culls, the reflection of one eye (taking turns) or of both. Every stereo
+    /// camera pre-culls (RepoXR's UI camera too): the first one that sees a mirror renders them for the frame
+    /// </summary>
+    private static void RenderSinglePass(Camera camera)
+    {
+        if (!PerEye || !camera || !camera.stereoEnabled || mirrors.Count == 0 || !Shown ||
+            singlePassFrame == Time.frameCount)
+            return;
+
+        var both = SinglePassMode == Config.ShopMirrorSinglePassOption.BothEyes;
+        foreach (var mirror in mirrors)
+        {
+            if (!mirror || !mirror.ShouldRender(camera))
+                continue;
+
+            singlePassFrame = Time.frameCount;
+            ResolutionSet(mirror, both ? 0.5f : 1);
+            if (both || (Time.frameCount & 1) == 0)
+                RenderSinglePassEye(mirror, camera, Camera.StereoscopicEye.Left);
+            if (both || (Time.frameCount & 1) == 1)
+                RenderSinglePassEye(mirror, camera, Camera.StereoscopicEye.Right);
+        }
+    }
+
+    /// <summary>
+    /// The game renders into its reflection texture: for the right eye that is the second texture for the time being.
+    /// Its textures are (re)made first, so that the game never replaces the second one
+    /// </summary>
+    private static void RenderSinglePassEye(MirrorReflection mirror, Camera camera, Camera.StereoscopicEye eye)
+    {
+        if (loggedEyes.Add(eye == Camera.StereoscopicEye.Left ? Camera.MonoOrStereoscopicEye.Left : Camera.MonoOrStereoscopicEye.Right))
+            Logger.LogInfo($"[Mirror] rendering the {eye} eye's reflection, single-pass ({camera.name}, frame {Time.frameCount})");
+
+        currentEye = eye;
+        MirrorReflection.insideRendering = true;
+        RenderTexture? left = null;
+        try
+        {
+            if (eye == Camera.StereoscopicEye.Right)
+            {
+                mirror.EnsureResources();
+                left = mirror.reflectionTexture;
+                mirror.reflectionTexture = RightEyeTexture(mirror, left);
+            }
+
+            mirror.RenderReflection(camera);
+
+            // Until the right eye has its own reflection it shows the left's
+            if (eye == Camera.StereoscopicEye.Left && !rightEyeTextures.ContainsKey(mirror))
+                BindRightEye(mirror, mirror.reflectionTexture);
+        }
+        catch (Exception e)
+        {
+            if (!loggedError)
+            {
+                loggedError = true;
+                Logger.LogWarning($"[Mirror] single-pass reflection failed: {e}");
+            }
+        }
+        finally
+        {
+            if (left)
+                mirror.reflectionTexture = left;
+            MirrorReflection.insideRendering = false;
+            currentEye = null;
+        }
+    }
+
+    private static RenderTexture RightEyeTexture(MirrorReflection mirror, RenderTexture left)
+    {
+        if (!rightEyeTextures.TryGetValue(mirror, out var right) || !right || right.width != left.width ||
+            right.height != left.height || right.depth != left.depth)
+        {
+            if (right)
+                UnityEngine.Object.Destroy(right);
+
+            right = new RenderTexture(left.descriptor) { name = left.name + " right eye", hideFlags = HideFlags.DontSave };
+            rightEyeTextures[mirror] = right;
+        }
+
+        BindRightEye(mirror, right);
+        return right;
+    }
+
+    /// <summary>The mirror's shader reads the right eye's reflection from _ReflectionTexRight</summary>
+    private static void BindRightEye(MirrorReflection mirror, Texture? texture)
+    {
+        var renderer = mirror.mirrorRenderer;
+        if (!renderer || !texture || (rightEyeBound.TryGetValue(mirror, out var bound) && bound == texture))
+            return;
+
+        renderer.GetPropertyBlock(propertyBlock);
+        propertyBlock.SetTexture(ReflectionTexRight, texture);
+        renderer.SetPropertyBlock(propertyBlock);
+        rightEyeBound[mirror] = texture!;
+    }
+
+    /// <summary>Both eyes every frame render at half the mirror's resolution</summary>
+    private static void ResolutionSet(MirrorReflection mirror, float factor)
+    {
+        if (!resolutionScales.TryGetValue(mirror, out var scale))
+            resolutionScales[mirror] = scale = mirror.resolutionScale;
+        mirror.resolutionScale = scale * factor;
+    }
