diff --git a/Source/UI/QuestText.cs b/Source/UI/QuestText.cs
new file mode 100644
--- /dev/null
+++ b/Source/UI/QuestText.cs
@@ -0,0 +1,89 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using RepoQuest.Localization;
+using TMPro;
+using UnityEngine;
+using UnityEngine.Localization.Settings;
+
+namespace RepoXR.UI;
+
+/// <summary>The game's selected language is also the language of the additional Quest menus.</summary>
+public static class QuestText
+{
+    private static readonly HashSet<int> ReportedMissingFonts = new();
+    public static string Locale => LocalizationSettings.SelectedLocale
+        ? LocalizationSettings.SelectedLocale.Identifier.Code : "en-US";
+    public static string Get(string key) => QuestStrings.Get(key, Locale);
+    public static string Literal(string text) => QuestStrings.Literal(text, Locale);
+
+    public static void Bind(TMP_Text text, string key)
+    {
+        var binding = text.GetComponent<QuestTextBinding>() ?? text.gameObject.AddComponent<QuestTextBinding>();
+        binding.Key = key;
+        binding.Apply();
+    }
+
+    public static void BindTree(GameObject root)
+    {
+        foreach (var text in root.GetComponentsInChildren<TMP_Text>(true))
+        {
+            if (text.GetComponent<QuestTextBinding>()) continue;
+            var entry = QuestStrings.Entries.FirstOrDefault(p =>
+                string.Equals(p.Value[0], text.text, StringComparison.OrdinalIgnoreCase));
+            if (entry.Key != null) Bind(text, entry.Key);
+        }
+    }
+
+    public static void Fit(TMP_Text text, bool wrap = false)
+    {
+        if (!text) return;
+        // Reuse a game font with Cyrillic support, never a broken font from the old RepoXR bundle.
+        if (QuestStrings.IsRussian(Locale))
+        {
+            GameFonts.FixBundlePrefabs();
+            if (!GameFonts.SupportsRussian(text.font))
+            {
+                var fallback = Resources.FindObjectsOfTypeAll<TMP_FontAsset>().FirstOrDefault(GameFonts.SupportsRussian);
+                if (fallback)
+                {
+                    text.font = fallback;
+                    text.fontSharedMaterial = TmpAsset.GetMaterial(fallback);
+                }
+                else if (ReportedMissingFonts.Add(text.GetInstanceID()))
+                    Debug.LogWarning("[QuestLocale] no loaded game font supports Cyrillic for " + text.name);
+            }
+        }
+        if (!text.enableAutoSizing)
+            text.fontSizeMax = text.fontSize;
+        text.fontSizeMin = Mathf.Min(14f, text.fontSizeMax);
+        text.enableAutoSizing = true;
+        text.enableWordWrapping = wrap;
+    }
+}
+
+internal sealed class QuestTextBinding : MonoBehaviour
+{
+    public string Key = "";
+    private string locale;
+
+    private void LateUpdate()
+    {
+        if (locale != QuestText.Locale) Apply();
+    }
+
+    public void Apply()
+    {
+        if (string.IsNullOrEmpty(Key)) return;
+        locale = QuestText.Locale;
+        var text = GetComponent<TMP_Text>();
+        text.text = QuestText.Get(Key);
+        if (GetComponentInParent<MenuButton>() is { } button && button.buttonText == text)
+        {
+            button.buttonTextString = text.text;
+            // ResizeToText preserves the original bounds used for centering and navigation.
+            button.ResizeToText();
+        }
+        QuestText.Fit(text);
+    }
+}
