 /// </summary>
 internal static class GameFonts
 {
+    internal static bool SupportsRussian(TMP_FontAsset font)
+    {
+        if (!Usable(font) || FromBundle(font)) return false;
+        for (var character = 'А'; character <= 'я'; character++)
+            if (!font.HasCharacter(character, true, true)) return false;
+        return font.HasCharacter('Ё', true, true) && font.HasCharacter('ё', true, true);
+    }
