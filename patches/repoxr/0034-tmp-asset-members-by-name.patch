+/// <summary>
+/// TMP_Asset's material and hash codes, by name. RepoXR is compiled against the game's TextMeshPro, where they are
+/// fields; the Quest build compiles the game with Unity 6's uGUI 2.0, where they are properties, and IL2CPP rejects
+/// the field references ("Unresolved field reference: TMP_Asset::material")
+/// </summary>
+internal static class TmpAsset
+{
+    private const BindingFlags Flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance;
+
+    public static Material? GetMaterial(TMPro.TMP_Asset asset) => Get(asset, "material") as Material;
+
+    public static object? Get(TMPro.TMP_Asset asset, string name)
+    {
+        var type = asset.GetType();
+        if (AccessTools.Property(type, name) is { CanRead: true } property)
+            return property.GetValue(asset);
+        return (AccessTools.Field(type, name) ?? AccessTools.Field(type, "m_" + char.ToUpper(name[0]) + name[1..]))
+            ?.GetValue(asset);
+    }
+
+    public static void Set(TMPro.TMP_Asset asset, string name, object value)
+    {
+        var type = asset.GetType();
+        if (AccessTools.Property(type, name) is { CanWrite: true } property)
+            property.SetValue(asset, value);
+        else
+            (AccessTools.Field(type, name) ?? AccessTools.Field(type, "m_" + char.ToUpper(name[0]) + name[1..]))
+                ?.SetValue(asset, value);
+    }
+}
